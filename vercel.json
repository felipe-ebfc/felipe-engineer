{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://felipe.engineer" },
        { "key": "Access-Control-Allow-Methods", "value": "POST" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/food", "destination": "https://felipe-food-log.vercel.app/food" },
    { "source": "/food/", "destination": "https://felipe-food-log.vercel.app/food/" },
    { "source": "/food/:path+", "destination": "https://felipe-food-log.vercel.app/food/:path*" }
  ]
}
